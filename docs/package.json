{
  "name": "m1sdock-docs",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "vite --config boot-sequence/vite.config.ts",
    "watch:boot": "vite build --watch --config boot-sequence/vite.config.ts",
    "test": "node --test boot-sequence/timeline.test.ts",
    "build:boot": "tsc --noEmit && vite build --config boot-sequence/vite.config.ts",
    "build": "npm run build:boot && mdbook build",
    "serve": "npm run build:boot && mdbook serve"
  },
  "dependencies": {
    "@xyflow/react": "12.12.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.3",
    "vite": "8.3.4"
  }
}
